# Banco de dados PostgreSQL (desenvolvimento)
DATABASE_URL=postgres://banqueiro:banqueiro_dev_password@localhost:5432/banqueiro_dev
# Banco usado pelos testes de integração e E2E (é recriado a cada execução)
TEST_DATABASE_URL=postgres://banqueiro:banqueiro_dev_password@localhost:5432/banqueiro_test

# Chave de 32 bytes em base64 para cifrar campos sensíveis (gere com: openssl rand -base64 32)
APP_ENCRYPTION_KEY=

# Fuso horário usado para "hoje" nos cálculos
APP_TIMEZONE=America/Sao_Paulo

# IA (opcional). Sem chave, o assistente funciona em "modo local" (regras determinísticas, sem LLM).
# Gratuito: GROQ_API_KEY (plano gratuito da Groq). Pago: ANTHROPIC_API_KEY (tem prioridade se as duas existirem).
GROQ_API_KEY=
GROQ_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# E-mail (opcional): liga o "Esqueci minha senha". Com Gmail, o endereço e uma senha de app.
# Outro provedor: SMTP_HOST e SMTP_PORT (padrão smtp.gmail.com:465). Veja docs/13.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=
SMTP_PORT=
EMAIL_FROM=

# Open Finance via Pluggy (opcional): chaves gerais de reserva. O normal é cada pessoa colar as
# próprias chaves gratuitas em Conectar banco (ficam cifradas no banco de dados).
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=

# Opcional: segredo da rotina diária de sincronização (/api/cron/sync)
CRON_SECRET=
# Opcional: quem recebe o aviso por e-mail quando a rotina diária encontra um problema (padrão: SMTP_USER)
ADMIN_EMAIL=
