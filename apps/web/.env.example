# ---------------------------------------------------------------------------------------------
# MY OFFICE AI — app web (Vercel). Copie para apps/web/.env.local no desenvolvimento.
# ---------------------------------------------------------------------------------------------

# Supabase › Project Settings › API (Data API): URL do projeto e chave PUBLICÁVEL (sb_publishable_…).
# A chave publicável é pública por desenho; quem protege os dados é a RLS. Nunca use a secret/service_role aqui.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Conexão do servidor com o Postgres (Supabase › Connect › Transaction pooler, porta 6543).
# Recomendado: usuário myoffice_app.<project-ref> (supabase/hardening/app-role.sql).
SUPABASE_DB_URL=

# Opcional: só estes e-mails entram (separados por vírgula). Vazio = qualquer conta do projeto Supabase.
MYOFFICE_ALLOWED_EMAILS=

# Opcional: endereço público do site (links de confirmação de e-mail). Sem ele, usa o endereço da requisição.
SITE_URL=
