{
  "name": "nexo-financas",
  "version": "0.1.0",
  "private": true,
  "description": "Rumo — plataforma inteligente de gestão financeira pessoal",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:setup": "tsx scripts/db-setup.ts",
    "db:seed-demo": "tsx scripts/seed-demo.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.137.0",
    "@fontsource-variable/inter": "5.3.0",
    "@vercel/functions": "3.10.2",
    "clsx": "2.1.1",
    "decimal.js": "10.6.0",
    "drizzle-orm": "0.45.4",
    "lucide-react": "1.60.0",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.8",
    "drizzle-kit": "0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.2",
    "postcss": "^8.5.31",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "3.2.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
